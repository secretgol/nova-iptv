<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AndroidBoxIPTV" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
    </style>

    <style name="Theme.AndroidBoxIPTV.Player" parent="Theme.AndroidBoxIPTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:keepScreenOn">true</item>
    </style>
</resources>
