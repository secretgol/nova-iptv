<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/cardChannel"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:orientation="vertical"
        android:background="@drawable/bg_channel_card"
        android:focusable="true"
        android:clickable="true"
        android:padding="10dp"
        android:gravity="center">

        <!-- Top row: Channel number & Favorite badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtChannelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                tools:text="1" />

            <ImageView
                android:id="@+id/imgFavorite"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_favorite"
                android:visibility="gone"
                android:layout_alignParentEnd="true"
                tools:visibility="visible" />
        </RelativeLayout>

        <!-- Channel Logo -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginVertical="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tv"
            android:contentDescription="@string/channels" />

        <!-- Channel Name -->
        <TextView
            android:id="@+id/txtChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="TRT 1 HD" />

    </LinearLayout>

</FrameLayout>
