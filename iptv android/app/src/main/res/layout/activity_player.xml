<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- ExoPlayer Video Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="surface_view"
        app:resize_mode="fit" />

    <!-- Buffering Indicator -->
    <ProgressBar
        android:id="@+id/progressBuffering"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_blue"
        android:visibility="gone" />

    <!-- Error Overlay with Auto-retry -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_channel_card"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/txtErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/stream_error"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button"
            android:text="Tekrar Dene"
            android:textColor="@color/white"
            android:paddingHorizontal="24dp"
            android:focusable="true" />
    </LinearLayout>

    <!-- OSD Top Bar (Fades in/out) -->
    <LinearLayout
        android:id="@+id/layoutOsdTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_osd_gradient_top"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp"
        android:gravity="center_vertical">

        <!-- Live Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#D32F2F"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="CANLI"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Channel Number -->
        <TextView
            android:id="@+id/txtPlayerChannelNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/accent_blue"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="1" />

        <!-- Channel Name -->
        <TextView
            android:id="@+id/txtPlayerChannelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="TRT 1 HD" />

        <!-- Category Badge -->
        <TextView
            android:id="@+id/txtPlayerCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="#232E42"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Ulusal" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Aspect Ratio Button / Indicator -->
        <Button
            android:id="@+id/btnAspectRatio"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button"
            android:text="Oran: Orijinal"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:focusable="true" />

        <!-- Favorite Button -->
        <ImageButton
            android:id="@+id/btnPlayerFavorite"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button"
            android:src="@drawable/ic_favorite_border"
            android:focusable="true"
            android:contentDescription="@string/favorites" />

        <!-- Clock -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- OSD Bottom Bar (Channel info & remote guide) -->
    <LinearLayout
        android:id="@+id/layoutOsdBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_osd_gradient_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingBottom="20dp"
        android:paddingTop="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ ▲ / ▼ ] Önceki / Sonraki Kanal"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="[ ◀ ] Hızlı Kanal Listesi"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="[ OK ] Bilgi Çubuğu"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtPlayerStreamUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                tools:text="HLS Live Stream" />
        </LinearLayout>
    </LinearLayout>

    <!-- Side Quick Channel Drawer (Appears when pressing Left arrow or Channel list button) -->
    <LinearLayout
        android:id="@+id/layoutQuickDrawer"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F20B0E14"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📺 Hızlı Kanal Listesi"
            android:textColor="@color/accent_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuickChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:listitem="@layout/item_channel" />
    </LinearLayout>

</FrameLayout>
