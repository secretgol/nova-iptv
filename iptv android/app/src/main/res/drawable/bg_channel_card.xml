<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state (D-pad selected) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <corners android:radius="@dimen/tv_card_corner_radius" />
            <stroke android:width="@dimen/tv_focus_stroke_width" android:color="@color/border_focused" />
        </shape>
    </item>
    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <corners android:radius="@dimen/tv_card_corner_radius" />
            <stroke android:width="2dp" android:color="@color/accent_blue" />
        </shape>
    </item>
    <!-- Normal default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="@dimen/tv_card_corner_radius" />
            <stroke android:width="1dp" android:color="@color/border_card" />
        </shape>
    </item>
</selector>
